# Copy to .env and fill in real values — never commit the real .env file.

# Postgres connection string (Neon/Supabase/self-hosted).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Kavenegar Verify Lookup API — see lib/sms.js for how these are used.
KAVENEGAR_API_KEY="your-kavenegar-api-key"
KAVENEGAR_TEMPLATE_CONFIRMED="your-approved-template-name-for-confirmed"
KAVENEGAR_TEMPLATE_REJECTED="your-approved-template-name-for-rejected"

# Telegram bot — from @BotFather.
TELEGRAM_BOT_TOKEN="123456789:AAaaBBbbCCccDDddEEeeFFffGGggHHhh"
# Any random secret string — must match the secret_token passed to setWebhook.
TELEGRAM_WEBHOOK_SECRET="a-random-secret-string"

# The private Telegram group whose membership drives 'member' role sync
# (docs/ROLE_GAP.md §6). Negative number, obtained by adding the bot to the
# group and reading ctx.chat.id off a real event — not fabricable ahead of time.
TYVO_GROUP_ID="-1000000000000"
